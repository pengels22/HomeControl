<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="#9A7BFF" />
            <stroke android:width="1dp" android:color="#C9BBFF" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="20dp" />
            <solid android:color="#7656D6" />
            <stroke android:width="1dp" android:color="#AA96FF" />
        </shape>
    </item>
</selector>
