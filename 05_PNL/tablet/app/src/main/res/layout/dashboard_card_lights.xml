<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lights_card" android:layout_width="0dp" android:layout_height="0dp"
    android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_margin="5dp"
    android:padding="13dp" android:orientation="vertical" android:background="@drawable/dashboard_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="☀  Lights" android:textColor="#F5FBFF" android:textSize="20sp" android:textStyle="bold" />
        <Button android:id="@+id/lights_all_off" android:layout_width="92dp" android:layout_height="38dp" android:background="@drawable/dashboard_control_button" android:text="All Off" android:textColor="#F5FBFF" android:textSize="12sp" android:enabled="false" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="5dp" android:background="#336C8494" />
    <TextView android:id="@+id/lights_label" android:layout_width="wrap_content" android:layout_height="0dp" android:layout_weight="0" android:visibility="gone" android:text="Living Room" />
    <LinearLayout android:id="@+id/lights_controls" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="2dp" android:orientation="vertical" />
    <TextView android:id="@+id/office_bench_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Bench Controls" android:textColor="#D7E5EF" android:textSize="14sp" android:textStyle="bold" android:visibility="gone" />
    <LinearLayout android:id="@+id/office_bench_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
    <TextView android:id="@+id/lights_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Waiting for Home Assistant" android:textColor="#C4D9E8" android:textSize="10sp" />
    <Switch android:id="@+id/lights_toggle" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:enabled="false" />
    <SeekBar android:id="@+id/lights_brightness" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:enabled="false" android:max="100" />
    <TextView android:id="@+id/lights_brightness_text" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:text="Brightness: —" />
</LinearLayout>
