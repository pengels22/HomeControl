<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/climate_card" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="5dp" android:padding="10dp" android:orientation="vertical" android:background="@drawable/dashboard_card">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="♨  Climate" android:textColor="#F5FBFF" android:textSize="18sp" android:textStyle="bold" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="3dp" android:background="#336C8494" />
    <LinearLayout android:id="@+id/climate_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15" android:gravity="center_vertical" android:orientation="vertical">
            <TextView android:id="@+id/climate_current" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="#F5FBFF" android:textSize="44sp" android:textStyle="bold" />
            <TextView android:id="@+id/climate_target" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Currently —&#10;Cooling to —" android:textColor="#D7E5EF" android:textSize="13sp" android:lineSpacingExtra="2dp" />
            <TextView android:id="@+id/climate_environment" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Inside — • —%&#10;Outside — • —%" android:textColor="#C4D9E8" android:textSize="12sp" android:lineSpacingExtra="2dp" />
            <TextView android:id="@+id/climate_status" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:text="" android:textColor="#78D7FF" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
                <Button android:id="@+id/climate_down" android:layout_width="60dp" android:layout_height="60dp" android:background="@drawable/climate_round_button" android:text="−" android:textColor="#F5FBFF" android:textSize="28sp" android:enabled="false" />
                <Button android:id="@+id/climate_up" android:layout_width="60dp" android:layout_height="60dp" android:layout_marginStart="8dp" android:background="@drawable/climate_round_button" android:text="+" android:textColor="#F5FBFF" android:textSize="28sp" android:enabled="false" />
            </LinearLayout>
            <LinearLayout android:id="@+id/climate_mode_buttons" android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="8dp" android:gravity="center" android:orientation="horizontal" />
        </LinearLayout>
    </LinearLayout>
    <Spinner android:id="@+id/climate_mode" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" android:enabled="false" />
</LinearLayout>
