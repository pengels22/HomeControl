<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/shop_card" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="5dp" android:padding="10dp" android:orientation="vertical" android:background="@drawable/dashboard_card">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙  Shop" android:textColor="#F5FBFF" android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/shop_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Connecting…" android:textColor="#C4D9E8" android:textSize="10sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:layout_marginTop="4dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal"><Button android:id="@+id/shop_bench1_5v" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/dashboard_control_button" android:backgroundTint="@null" android:text="Bench 1 5V" android:textAllCaps="false" android:textColor="#F5FCFF" android:textSize="10sp" /><Button android:id="@+id/shop_bench1_12v" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/dashboard_control_button" android:backgroundTint="@null" android:text="Bench 1 12V" android:textAllCaps="false" android:textColor="#F5FCFF" android:textSize="10sp" /></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal"><Button android:id="@+id/shop_bench2_5v" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/dashboard_control_button" android:backgroundTint="@null" android:text="Bench 2 5V" android:textAllCaps="false" android:textColor="#F5FCFF" android:textSize="10sp" /><Button android:id="@+id/shop_bench2_12v" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/dashboard_control_button" android:backgroundTint="@null" android:text="Bench 2 12V" android:textAllCaps="false" android:textColor="#F5FCFF" android:textSize="10sp" /></LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal"><Button android:id="@+id/shop_bench3_5v" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/dashboard_control_button" android:backgroundTint="@null" android:text="Bench 3 5V" android:textAllCaps="false" android:textColor="#F5FCFF" android:textSize="10sp" /><Button android:id="@+id/shop_bench3_12v" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="2dp" android:background="@drawable/dashboard_control_button" android:backgroundTint="@null" android:text="Bench 3 12V" android:textAllCaps="false" android:textColor="#F5FCFF" android:textSize="10sp" /></LinearLayout>
        <Button android:id="@+id/shop_all_off" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="0.8" android:layout_margin="2dp" android:background="@drawable/dashboard_control_button" android:backgroundTint="@null" android:text="ALL SHOP OFF" android:textAllCaps="false" android:textColor="#FFCDD2" android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
