[Unit]
Description=HomeControl read-only host network status snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/hcm-host-network-status --output /srv/hcm-data/homecontrol/.state/host-network-status.json
User=root
NoNewPrivileges=true
PrivateTmp=true
CapabilityBoundingSet=CAP_DAC_OVERRIDE
RestrictAddressFamilies=AF_UNIX AF_NETLINK
