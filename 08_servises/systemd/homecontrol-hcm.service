[Unit]
Description=HomeControl HCM
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/HomeControl
Environment=PYTHONPATH=/opt/HomeControl
ExecStart=/opt/HomeControl/.venv/bin/uvicorn 01_HCM.main:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
