[Unit]
Description=HomeControl authenticated module update service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=homecontrol
Group=homecontrol
WorkingDirectory=/var/lib/homecontrol
EnvironmentFile=-/etc/homecontrol/update-service.env
ExecStart=/opt/homecontrol/.venv/bin/python /opt/homecontrol/08_servises/update_service.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/homecontrol/updates/staging
ReadWritePaths=/var/lib/homecontrol/update-state
ReadOnlyPaths=/etc/homecontrol

[Install]
WantedBy=multi-user.target
